{% set context = hookable_metadata.context %}
{% set billingAddress = context.billingAddress %}

<div
    {{ stimulus_controller('@sylius/paypal-plugin/paypal-card-fields', {
        scriptUrl: context.webSdkScriptUrl,
        instanceConfig: context.webSdkInstanceConfig,
        currencyCode: context.currency,
        createOrderUrl: context.createPayPalOrderUrl,
        completeOrderUrl: context.completePayPalOrderUrl,
        errorUrl: context.errorPayPalPaymentUrl,
        billingAddress: billingAddress is null ? {} : {
            streetAddress: billingAddress.street,
            city: billingAddress.city,
            postalCode: billingAddress.postcode,
            countryCode: billingAddress.countryCode,
        },
    }) }}
    hidden
>
    <form {{ stimulus_target('@sylius/paypal-plugin/paypal-card-fields', 'form') }}>
        <div class="mb-3">
            <label class="form-label">{{ 'sylius_paypal.credit_card_number'|trans }}</label>
            <div {{ stimulus_target('@sylius/paypal-plugin/paypal-card-fields', 'number') }}></div>
        </div>

        <div class="row">
            <div class="col-6 mb-3">
                <label class="form-label">{{ 'sylius_paypal.expiration_date'|trans }}</label>
                <div {{ stimulus_target('@sylius/paypal-plugin/paypal-card-fields', 'expiry') }}></div>
            </div>
            <div class="col-6 mb-3">
                <label class="form-label">{{ 'sylius_paypal.cvv'|trans }}</label>
                <div {{ stimulus_target('@sylius/paypal-plugin/paypal-card-fields', 'cvv') }}></div>
            </div>
        </div>

        <button
            type="submit"
            {{ stimulus_target('@sylius/paypal-plugin/paypal-card-fields', 'submit') }}
            class="btn btn-primary w-100"
        >
            {{ 'sylius_paypal.pay_with_card'|trans }}
        </button>
    </form>
</div>
