{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'sylius_paypal.pay_with_paypal'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    <div class="container my-auto">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">
                <h1 class="h3 mb-4 text-center">{{ 'sylius_paypal.pay_with_paypal'|trans }}</h1>

                {% hook 'sylius_paypal.shop.pay_with_paypal.content' with {
                    billingAddress: billingAddress,
                    cancelPayPalPaymentUrl: cancelPayPalPaymentUrl,
                    completePayPalOrderUrl: completePayPalOrderUrl,
                    createPayPalOrderUrl: createPayPalOrderUrl,
                    currency: currency,
                    errorPayPalPaymentUrl: errorPayPalPaymentUrl,
                    order: order,
                    payment: payment,
                    webSdkInstanceConfig: webSdkInstanceConfig,
                    webSdkScriptUrl: webSdkScriptUrl,
                } %}

                <a href="{{ path('sylius_shop_order_show', { tokenValue: order.tokenValue }) }}" class="btn btn-link w-100 mt-3">
                    {{ 'sylius_paypal.back_to_store'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
